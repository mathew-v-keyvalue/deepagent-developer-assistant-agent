# MCP client (shared developer-tools MCP server — run separately, no auth required)
MCP_URL=http://localhost:8081/sse
MCP_CLIENT_TRANSPORT=sse

# Agent / LLM
# Use one of: anthropic:claude-sonnet-4-6 | openai:gpt-4o | etc.
AGENT_MODEL=anthropic:claude-sonnet-4-6
AGENT_TEMPERATURE=0
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Eval
AUTO_APPROVE_WRITES=false
REFERENCE_DATE=2026-07-09
PRIMARY_USER_ID=U001
